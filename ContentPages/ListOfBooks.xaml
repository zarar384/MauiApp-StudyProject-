<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_StudyProject_.ContentPages.ListOfBooks"
             Title="List Of Books">
    <VerticalStackLayout Padding="24" Spacing="16">
        
        <Label Text="My library" Style="{StaticResource SectionHeadingStyle}" />

        <Label Text="There you can find all your books." />

        <Label Text="Currently reading" Style="{StaticResource SectionHeadingStyle}" />

        <!--List of currently reading books-->
        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CurrentReadBooks}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Label Text="Favorite books" Style="{StaticResource SectionHeadingStyle}" />

        <!--List of favorite books-->
        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding FavoriteBooks}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>