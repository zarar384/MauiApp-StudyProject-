<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_StudyProject_.ContentPages.ProfileLayoutPage"
             Title="Profile Layout Page">
    <Grid Padding="20"
          RowSpacing="20"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!--Title-->
        <Label Grid.Row="0"
               Text="My Profile"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!--User information-->
        <Grid Grid.Row="1"
              ColumnSpacing="20"
              ColumnDefinitions="Auto,*">

            <Border Grid.Column="0"
                    WidthRequest="80"
                    HeightRequest="80"
                    StrokeShape="RoundRectangle 40">

                <Label Text="F"
                       FontSize="32"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 VerticalOptions="Center"
                                 Spacing="5">

                <Label Text="Pivnoy"
                       FontSize="22"
                       FontAttributes="Bold"/>

                <Label Text="Boh"
                          FontSize="16"
                          TextColor="Gray"/>

            </VerticalStackLayout>
        </Grid>

        <!--User details-->
        <Grid Grid.Row="2"
                  RowSpacing="10"
                  ColumnSpacing="20"
                  ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto">

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="Email:" />

            <Label Grid.Row="0"
                   Grid.Column="1"
                   Text="pivnoy.boh@example.com" />

            <Label Grid.Row="1"
                   Grid.Column="0"
                   Text="Company:" />

            <Label Grid.Row="1"
                   Grid.Column="1"
                   Text="My Company" />

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Text="Location:" />

            <Label Grid.Row="2"
                   Grid.Column="1"
                   Text="Afghanistan" />
        </Grid>

        <!--Separator-->
        <BoxView Grid.Row="3"
                 HeightRequest="1"
                 HorizontalOptions="Fill"/>

        <!--Settings-->
        <Grid Grid.Row="4"
              RowSpacing="15"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto">

            <Label Grid.Row="0"
                   Grid.Column="0"
                   Text="Notifications"
                   VerticalOptions="Center" />

            <Switch Grid.Row="0"
                    Grid.Column="1"
                    IsToggled="True" />

            <Label Grid.Row="1"
                   Grid.Column="0"
                   Text="Dark Mode"
                   VerticalOptions="Center" />

            <Switch Grid.Row="1"
                    Grid.Column="1"
                    IsToggled="False" />

        </Grid>

        <!--Buttons at the bottom-->
        <Button Grid.Row="5"
                Text="Save Changes"
                HorizontalOptions="Center"
                VerticalOptions="End" />
    </Grid>
</ContentPage>